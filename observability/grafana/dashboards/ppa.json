   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(ppa_idempotent_replays_total[5m])",
     "legendFormat": "idempotent replays",
     "datasource": {
