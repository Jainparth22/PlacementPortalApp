   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(flower_events_total{type=~\"task-succeeded|task-failed|task-retried\"}[5m])) by (type)",
     "legendFormat": "{{type}}",
     "datasource": {
      "type": "prometheus",
