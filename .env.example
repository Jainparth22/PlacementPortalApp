# Copy to .env for local, or set as Railway Variables

# Flask
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
FLASK_ENV=production
PORT=5001

# Database — Railway Postgres auto-sets DATABASE_URL, local uses SQLite if unset
# For local SQLite test: leave DATABASE_URL unset or set USE_SQLITE=1
# For prod Postgres: DATABASE_URL=postgresql://user:pass@host:5432/railway
DATABASE_URL=postgresql://user:pass@localhost:5432/ppa
# Alternative local: sqlite:///C:/path/to/PPA/backend/instance/ppa.db

# Redis — Railway Redis plugin auto-sets REDIS_URL
REDIS_URL=redis://localhost:6379/0
# Optional overrides (defaults to REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage — Railway Volume mount at /data (separate volume for resumes)
# Local: backend/uploads | Railway: /data/uploads
UPLOAD_FOLDER=/data/uploads
REPORTS_FOLDER=/data/reports
EXPORTS_FOLDER=/data/exports

# Mail / Webhook
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# Admin
ADMIN_EMAIL=jainparth7040@gmail.com
ADMIN_PASSWORD=admin123
