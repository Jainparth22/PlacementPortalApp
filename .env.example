# Copy to .env for local development. Real environment variables always override this file.
# Docker Compose reads it too (everything has a working default, so .env is optional).

# --- Mode ---------------------------------------------------------------
# development (default): SQLite, verbose logs, migrations auto-applied on boot, demo data seeded.
# production: secrets below are REQUIRED, logs are JSON/WARNING, run `flask db upgrade` yourself.
APP_ENV=development
PORT=5001

# --- Secrets (required when APP_ENV=production; use 32+ random chars) ---
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# --- Database -----------------------------------------------------------
# Unset => SQLite file at backend/instance/ppa.db. PostgreSQL example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/ppa
AUTO_MIGRATE=1          # dev: apply Alembic migrations on boot. production default is 0.
AUTO_SEED=1             # seed demo accounts when the DB is empty (0 to disable)

# --- Redis (three logical roles; locally one server is fine, DB 0/1/2) ---
# cache  : disposable (LRU-evictable)            -> REDIS_URL
# broker : Celery queue (must not be evicted)    -> CELERY_BROKER_URL   (default: REDIS_URL with /1)
# state  : JWT blacklist, rate limits, DLQ       -> STATE_REDIS_URL     (default: broker URL with /2)
REDIS_URL=redis://localhost:6379/0
# Run without Redis at all (pure in-memory cache, inline tasks)? Set REDIS_URL= and STATE_REDIS_URL= to empty.
# (A refused connection can take ~2s per probe on Windows; the circuit breaker probes a dead Redis at most once a minute.)
# CELERY_BROKER_URL=redis://localhost:6379/1
# STATE_REDIS_URL=redis://localhost:6379/2
# CACHE_KEY_VERSION=v1  # bump to invalidate every cached entry after changing a cached payload shape

# --- Storage (see docs/STORAGE.md) ----------------------------------------
# local (default) | s3 (AWS S3, Cloudflare R2, MinIO) | azure.  web AND worker must use the same backend/bucket.
# STORAGE_BACKEND=local
# UPLOAD_FOLDER=/data/uploads          (local backend only)
# REPORTS_FOLDER=/data/reports
# EXPORTS_FOLDER=/data/exports
# STORAGE_BACKEND=s3
# S3_BUCKET=ppa-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # only for R2 / MinIO
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...
# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=...   # or AZURE_STORAGE_ACCOUNT_URL=https://<acct>.blob.core.windows.net + managed identity
# AZURE_STORAGE_CONTAINER=ppa

# --- Sessions -------------------------------------------------------------
# JWT_ACCESS_TOKEN_EXPIRES=900          access token lifetime (seconds)
# REFRESH_TOKEN_DAYS=7                  refresh-token cookie lifetime
# COOKIE_SECURE=0                       set 1 when served over HTTPS (default 1 in production)
# COOKIE_SAMESITE=Strict

# --- Live notifications (SSE) ---------------------------------------------
# SSE_MAX_CONNECTIONS=50                per web process; each stream holds one thread
# SSE_MAX_SECONDS=300                   server ends the stream; client reconnects with Last-Event-ID

# --- Rate limits (per 60 seconds) ---------------------------------------
# LOGIN_RATE_LIMIT=20              per IP
# LOGIN_EMAIL_RATE_LIMIT=10        failed attempts per account
# HEAVY_ENDPOINT_RATE_LIMIT=10     per user: report generation, CSV export, ATS check

# --- Networking ---------------------------------------------------------
# Number of reverse proxies in front of the app (nginx, a load balancer...). Used to find the real
# client IP for rate limiting. 0 = none (safe default: X-Forwarded-For is ignored).
TRUSTED_PROXY_COUNT=0
# Cross-origin access to /api is OFF by default (the SPA is same-origin). Comma-separated list to enable:
# CORS_ORIGINS=https://app.example.com

# --- Observability ------------------------------------------------------
# METRICS_TOKEN=change-me               Bearer token for /metrics (no token: open in dev, DISABLED in production)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   enables OpenTelemetry tracing (Jaeger/Tempo/Azure Monitor collector)
# OTEL_SERVICE_NAME=ppa-web
# OTEL_TRACES_SAMPLER_ARG=1.0           sampling ratio 0..1
# LOG_LEVEL=DEBUG                  default: DEBUG in development, WARNING in production
# LOG_JSON=0                       default: 1 in production
# SENTRY_DSN=                      error tracking, only active when set

# --- Optional notifications (skipped when unset) ------------------------
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=app-password
# MAIL_DEFAULT_SENDER=you@example.com
# GCHAT_WEBHOOK_URL=
